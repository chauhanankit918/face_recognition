# Copy to .env and fill in. `docker compose` reads it automatically.
#
# Generate a key:
#   python -c 'from django.core.management.utils import get_random_secret_key as k; print(k())'
DJANGO_SECRET_KEY=

# Comma-separated hostnames this instance answers to.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Needed only when the admin is reached over HTTPS or a non-default host,
# e.g. https://faces.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Host port to publish.
PORT=8000

# 1 = download/load the InsightFace pack at container start instead of on the
# first API call (slower boot, no cold first request).
FACE_WARM_MODEL=0
